<resources>
    <!-- 品牌主色（与 `ic_launcher` 的紫、OSD 选中态的 `#7F77DD` 同一支）。
         深色底用 `brand` 会偏暗，可读性靠 `brand_tint`。 -->
    <color name="brand">#FF7F77DD</color>
    <color name="brand_tint">#FFA9A3F5</color>

    <!-- 页面底色。全 App 统一这一个值，别在代码里再写第二份 #101216。 -->
    <color name="surface">#FF101216</color>

    <!-- 启动页底色：比 surface 再深一档，让居中的图标更亮一点。 -->
    <color name="splash_bg">#FF0B0E15</color>
</resources>
