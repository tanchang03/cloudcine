<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ⛔ **别删这条**（2026-10-06 实测踩过）：全工程确实没有一处
         `ConnectivityManager`，我一度以为它是死权限并删掉了 —— 但 `aapt2 dump
         badging` 显示**产物里它还在**，因为它是 **`media3-exoplayer` 自己的
         manifest 合并进来的**（ExoPlayer 的 `Util.getNetworkType` 要用）。
         这里显式声明一份，是为了「依赖哪天不合并了也不会悄悄丢掉」，
         不是我们自己的需求。删了它只会让注释变成假的。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 唤醒锁：ExoPlayer 的 setWakeMode 用它，播放中不让系统休眠。
         云影那边是 media_kit 的 wakelock 插件在管，这里直接声明。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 电视上要能装：触摸屏与 leanback 都不作为硬性要求。 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- ⛔ 必须开：本地中继是明文 http://127.0.0.1:xxxxx，Android 9 起默认禁止。 -->
    <!-- ⛔ `largeHeap="true"` 是**必需**的，不是优化。
         本机 `getprop` 实测：`dalvik.vm.heapgrowthlimit=192m`、
         `dalvik.vm.heapsize=512m`、`ro.config.low_ram=true`。
         不开这个开关，App 的 Java 堆上限就是 **192 MiB**；而
         `ParallelRangeReader` 每实例一次性分配 `8 × 2 MiB = 16 MiB`
         槽位数组，一次拖拽的 seek 风暴足以把它打满（2026-10-06 真机：
         `FATAL EXCEPTION: cc-range-1 / OutOfMemoryError`，GC `freed 0(0B)`）。
         开了之后上限到 512 MiB，突发有了余量。
         ⚠️ 副作用（可控）：`PlayerActivity` 的缓冲预算按 `堆上限 / 4` 算，
         会从 48 MiB 升到 64 MiB —— 但那里有 `min(..., 64 MiB)` 封顶。 -->
    <application
        android:label="@string/app_name"
        android:largeHeap="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:theme="@style/AppTheme">

        <!-- 启动页：只看登录态，然后转去登录页或文件列表。
             ⛔ theme 覆盖成 SplashTheme（windowBackground 带品牌图标）——
                系统在 Activity 起来之前就画它，所以「黑屏一闪」变成品牌露出，
                且**不花启动时间**。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/SplashTheme"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 电视首页入口（遥控器能直接点开，不用每次都 adb）。 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 扫码登录页：二维码画在电视上，手机扫码。 -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 文件列表页：遥控器上下选择，OK 进目录 / 起播。 -->
        <activity
            android:name=".BrowseActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 媒体库页：读**同步下来的本地索引**（`cloudcine.sqlite`），
             菜单里做「同步 / 上传备份 / 从网盘恢复」。
             exported=true 与 PlayerActivity 同理：保留
             `adb shell am start -n com.cloudcine.tv/.LibraryActivity`
             这条直连路径，否则每次测备份都得先走一遍遥控器菜单。 -->
        <activity
            android:name=".LibraryActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 播放页：ExoPlayer + SurfaceView + 原生 OSD。这是要验证的那一页。
             exported=true 是为了保留「am start 时用 -e url 传地址」这条对照路径。 -->
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 手动刮削页：搜索豆瓣 / TMDB，挑一个候选落库。
             exported=true 与 LibraryActivity 同理 —— 保留
             `adb shell am start -n com.cloudcine.tv/.ScrapeActivity \
                  -e scrape_work_key <key> -e scrape_work_title <title>`
             这条直连路径，否则每测一次刮削都得先用遥控器翻到那个作品。
             ⛔ 不设 launchMode=singleTask：从详情页连着刮两部片是正常操作，
                单例会让第二次进入复用到上一次的 workKey。 -->
        <activity
            android:name=".ScrapeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 刮削设置页：TMDB Key / 两个反代地址 / 豆瓣 Cookie。
             这些值存在媒体库的 `settings` 表里，随备份包同步。
             exported=false：它没有任何启动参数，走详情页菜单进来即可。 -->
        <activity
            android:name=".ScrapeSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
